# Copy to .env.local to change how the portal signs in.
# dev  = pick a preset identity (backend must run with the h2 / dev-auth profile)
# oidc = real sign-in through Keycloak (docker compose up keycloak)
VITE_AUTH_MODE=dev
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/apigw
VITE_OIDC_CLIENT_ID=management-portal
