# Copy to backend-node/.env (git-ignored) and fill in. Nothing here may be committed with a real value.

# The same database backend-java migrates. The schema is 'apim'; Prisma needs it in the URL.
DATABASE_URL="postgresql://apigw:CHANGE_ME@localhost:5432/apigw?schema=apim"

# MUST match apigw.auth.jwt-secret in backend-java, or a portal session valid against one service is
# rejected by the other. At least 32 characters.
AUTH_JWT_SECRET=""

PORT=8089
NODE_ENV=development
