# Copy to backend-python/.env (git-ignored) and fill in. Nothing here may be committed with a real value.

# The same database backend-java migrates. asyncpg, not psycopg: a blocking driver stalls the event loop.
DATABASE_URL="postgresql+asyncpg://apigw:CHANGE_ME@localhost:5432/apigw"

# Which schema holds the tables — 'apim' under the Java service's local profile, 'public' by default.
# It becomes the connection's search_path, so no SQL in this service names a schema.
DB_SCHEMA=apim

# MUST match apigw.auth.jwt-secret in backend-java, or a portal session valid against one service is
# rejected by the other. At least 32 characters. Left empty outside production, both services fall
# back to the same built-in development key.
AUTH_JWT_SECRET=""

PORT=8090
ENVIRONMENT=development
