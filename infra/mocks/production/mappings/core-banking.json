{
  "mappings": [
    {
      "request": {
        "method": "POST",
        "urlPath": "/core/imps"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "txnId": "IMPS{{randomValue length=11 type='NUMERIC'}}",
          "status": "ACCEPTED",
          "rrn": "{{randomValue length=12 type='NUMERIC'}}",
          "initiatedAt": "{{now}}",
          "environment": "PRODUCTION"
        },
        "fixedDelayMilliseconds": 180
      }
    },
    {
      "request": {
        "method": "POST",
        "urlPath": "/core/neft"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "txnId": "NEFT{{randomValue length=11 type='NUMERIC'}}",
          "status": "PENDING",
          "environment": "PRODUCTION"
        },
        "fixedDelayMilliseconds": 220
      }
    },
    {
      "request": {
        "method": "GET",
        "urlPath": "/core/balance"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
