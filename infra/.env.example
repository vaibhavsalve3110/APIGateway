# Copy to infra/.env and change every value before anyone else can reach the stack.
#
# infra/.env is git-ignored and is the only place these live. Nothing here has a safe default: the
# values below are either placeholders or deliberately empty.
#
# Generating the three secrets (any Linux, macOS, or Git Bash on Windows):
#   AUTH_JWT_SECRET      openssl rand -base64 48
#   CRYPTO_MASTER_KEY    openssl rand -base64 32          # must decode to exactly 32 bytes
#   PAYLOAD_PRIVATE_KEY  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
#
# The two control planes share this database, these secrets and these tokens. Where a value appears
# on both, it has to be the same value — a difference is not a misconfiguration that fails loudly,
# it is two services disagreeing about what the platform allows.

# --------------------------------------------------------------------------- profile
# Leave both unset for a developer machine. For production set BOTH, or one service will enforce
# secrets and payload encryption while the other does not.
#   SPRING_PROFILES_ACTIVE=prod      (backend-java)
#   ENVIRONMENT=production           (backend-python)
#SPRING_PROFILES_ACTIVE=prod
#ENVIRONMENT=production

# --------------------------------------------------------------------------- database
# These point at the host's own PostgreSQL by default. Flyway in backend-java owns the schema and
# runs the migrations at startup; backend-python issues no DDL. One-time setup of the role, database
# and schema is infra/postgres/local-setup.sql.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_SCHEMA=apim
DB_PASSWORD=change-me-database-password

# --------------------------------------------------------------------------- secrets
# Signs and verifies session tokens, at least 32 characters. Both services must hold the same one or
# a session minted by whichever answered the sign-in is rejected by the other. Required under
# production; outside it, both fall back to a built-in development key.
AUTH_JWT_SECRET=

# Encrypts the few secrets the platform must read back, today a partner's IPV salt: 32 random bytes,
# base64. Changing it makes everything already stored unreadable, so rotating it means re-encrypting
# those values first. Required under production.
CRYPTO_MASTER_KEY=

# Decrypts every portal payload (VAPT). An unencrypted PKCS#8 RSA private key, PEM, 2048-bit or
# stronger, with the newlines escaped as \n so it fits on one line here. Required under production,
# where a missing key stops both services starting — deliberately, because the fallback is a
# development keypair committed to this repository and readable by anyone.
PAYLOAD_PRIVATE_KEY=

# Refuse unencrypted /api requests. Always on under the production profile whatever this says; off
# by default elsewhere so Swagger UI, curl and the test gates keep working.
#PAYLOAD_ENCRYPTION_ENFORCED=true

# --------------------------------------------------------------------------- gateways
# The APISIX admin API keys, one deployment per environment so sandbox credentials can never reach
# production. Both control planes configure both gateways, so these must match on each.
APISIX_SANDBOX_ADMIN_KEY=change-me-sandbox-admin-key
APISIX_PRODUCTION_ADMIN_KEY=change-me-production-admin-key

# Presented by the gateways on every usage batch they ship to /internal/usage/batch. Not a session.
USAGE_INGEST_TOKEN=change-me-ingest-token

# Shown to partners as the base URL to call, and whether Try-it-live is simulated (SIMULATE) or goes
# through the sandbox gateway (GATEWAY).
PUBLIC_SANDBOX_URL=https://sandbox-api.apigw.com
TRY_IT_MODE=GATEWAY

# false runs the platform with no gateway at all: APIs are managed and documented, nothing is
# published to a route. Useful for a portal-only environment.
GATEWAY_SYNC_ENABLED=true

# --------------------------------------------------------------------------- mail
# Empty SMTP_HOST means no mail is sent: a sign-in code is written to the backend log and returned
# in the response instead, which is fine on a developer machine and refused under production.
# Outbound SMTP is blocked on some corporate networks — see the runbook's error-checking tab.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@apigw.local

# Sends the new security key itself to the partner's admins. false sends only the change notice and
# leaves the key to the one-time reveal in the portal, which keeps a live credential out of mailboxes.
EMAIL_KEY_TO_ADMIN=true

# --------------------------------------------------------------------------- keycloak
# Runs in the local stack and nothing connects to it today. Safe to leave as is, or drop the service.
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-password
